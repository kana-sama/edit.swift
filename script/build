#!/bin/bash
set -euo pipefail
cd "$(dirname "$0")/.."
source script/app-bundle.sh

configuration="${1:-debug}"
case "$configuration" in
    debug|release) ;;
    *) printf 'Usage: %s [debug|release]\n' "$0" >&2; exit 2 ;;
esac

build_dir="${EDIT_BUILD_DIR:-$PWD/.build}"
sdk_cache="${EDIT_SDK_CACHE_DIR:-$PWD/.local/swift-sdk}"
bundle_name=Edit
product=Edit
if [[ "${EDIT_AGENT_BUILD:-0}" == 1 ]]; then
    bundle_name='Edit Agent'
    product=EditAgent
fi

compiler="$(xcrun --find swiftc)"
sdk="$(xcrun --sdk macosx --show-sdk-path)"
minimum_version="$(/usr/libexec/PlistBuddy -c 'Print :LSMinimumSystemVersion' resources/Info.plist)"
target="$(uname -m)-apple-macosx$minimum_version"
build_system=swiftbuild
swiftpm_scratch="$sdk_cache/swiftpm"
# Swift Build 6.4 can invalidate Debug products when it switches between CLT toolchain IDs.
if [[ "$configuration" == debug && "$compiler" == /Library/Developer/CommandLineTools/* ]]; then
    build_system=native
    swiftpm_scratch="$sdk_cache/swiftpm-native"
fi
sources=()
while IFS= read -r -d '' path; do
    if [[ "$bundle_name" == Edit && "$path" == Sources/Edit/Checks/* ]]; then continue; fi
    sources+=("$path")
done < <(/usr/bin/find -s Sources/Edit -type f -name '*.swift' -print0)

# Include toolchain and SDK identities so updates invalidate the finished bundle.
build_fingerprint() {
    {
        printf '%s\n' "$configuration" "$bundle_name" "$target" "$compiler" "$sdk" "$build_system" &&
        /usr/bin/stat -L -f '%i:%m:%c:%z' "$compiler" "$sdk/SDKSettings.plist" &&
        /usr/bin/shasum -a 256 "${sources[@]}" Package.swift Package.resolved resources/Info.plist resources/Edit.icns \
            script/build script/build-syntax script/app-bundle.sh script/publish-app.c Sources/Edit/Resources/Seti/* \
            Sources/EditSyntax/Highlight.m Sources/EditSyntaxABI/* resources/syntax/sources.tar.gz \
            resources/syntax/queries/*.scm resources/syntax/licenses/* resources/syntax/README.md
    } | /usr/bin/shasum -a 256
}

fingerprint="$(build_fingerprint)"
output="$build_dir/app/$configuration"
destination="$output/$bundle_name.app"
prune_retired_apps "$output"
stamp="$destination/Contents/Resources/build-fingerprint"
if [[ -f "$stamp" && "$(<"$stamp")" == "$fingerprint" ]] && verify_app "$destination" 2>/dev/null; then
    printf '%s is up to date.\n' "$bundle_name.app"
    exit 0
fi

# Keep SDK modules across a clean build of the project.
mkdir -p "$sdk_cache/clang" "$sdk_cache/modules" "$output"
stage="$(mktemp -d "$output/.edit-bundle.XXXXXX")"
app="$stage/$bundle_name.app"
syntax_pid=
finish_build() {
    if [[ -n "$syntax_pid" ]]; then
        wait "$syntax_pid" || true
    fi
    finish_app_stage "$stage" "$app"
}
trap finish_build EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

# SwiftPM links the editor product and its pinned dependencies. Package the
# executable under the same native bundle layout used by the app and checks.
editor_build=(/usr/bin/env "SWIFTPM_MODULECACHE_OVERRIDE=$sdk_cache/clang" "$(xcrun --find swift)" build
    --build-system "$build_system"
    --scratch-path "$swiftpm_scratch"
    --cache-path "$sdk_cache/swiftpm-cache"
    --config-path "$sdk_cache/swiftpm-config"
    --security-path "$sdk_cache/swiftpm-security"
    --configuration "$configuration" --triple "$target" --sdk "$sdk" --force-resolved-versions)

./script/build-syntax "$sdk_cache" "$sdk" "$target" > "$stage/syntax-library" &
syntax_pid=$!
"${editor_build[@]}" --product "$product" >&2
wait "$syntax_pid"
syntax_pid=

products="$swiftpm_scratch/$configuration"
if [[ "$build_system" != native || ! -x "$products/$product" ]]; then
    products="$("${editor_build[@]}" --show-bin-path)"
fi

mkdir -p "$app/Contents/MacOS" "$app/Contents/Resources/syntax" "$app/Contents/Frameworks"
cp -p "$products/$product" "$app/Contents/MacOS/Edit"
syntax_library="$(<"$stage/syntax-library")"
cp -p "$syntax_library" "$app/Contents/Frameworks/libEditSyntax.dylib"
cp -R resources/syntax/queries resources/syntax/licenses resources/syntax/README.md "$app/Contents/Resources/syntax/"
cp "$swiftpm_scratch/checkouts/SwiftTerm/LICENSE" "$app/Contents/Resources/SwiftTerm-LICENSE.txt"
cp resources/Info.plist "$app/Contents/Info.plist"
cp resources/Edit.icns "$app/Contents/Resources/"
cp -R Sources/Edit/Resources/Seti "$app/Contents/Resources/"
if [[ "$bundle_name" == 'Edit Agent' ]]; then
    /usr/libexec/PlistBuddy \
        -c 'Set :CFBundleIdentifier dev.edit-swift.Edit.agent' \
        -c 'Set :CFBundleName Edit Agent' \
        -c 'Set :CFBundleDisplayName Edit Agent' \
        -c 'Add :LSBackgroundOnly bool true' \
        "$app/Contents/Info.plist"
fi

if [[ "$(build_fingerprint)" != "$fingerprint" ]]; then
    printf 'Build inputs changed. Run the build again.\n' >&2
    exit 1
fi
printf '%s\n' "$fingerprint" > "$app/Contents/Resources/build-fingerprint"
sign_app "$app"
if [[ -d "$products/$product.dSYM" ]]; then
    cp -Rp "$products/$product.dSYM" "$stage/Edit.dSYM"
    publish_path "$stage/Edit.dSYM" "$output/$bundle_name.dSYM"
fi
publish_app "$app" "$destination"
