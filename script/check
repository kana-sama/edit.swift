#!/bin/bash
set -euo pipefail
if (( $# > 1 )); then
    printf 'Usage: %s [screenshot-path]\n' "$0" >&2
    exit 2
fi

screenshot="${1:-}"
if [[ -n "$screenshot" && "$screenshot" != /* ]]; then
    screenshot="$PWD/$screenshot"
fi
cd "$(dirname "$0")/.."

EDIT_AGENT_BUILD=1 ./script/build
agent_app="${EDIT_BUILD_DIR:-$PWD/.build}/app/debug/Edit Agent.app"
profile="$(mktemp -d)"
trap 'rm -rf -- "$profile"' EXIT
export JJ_CONFIG= JJ_USER="Edit Agent" JJ_EMAIL=edit-agent@example.invalid GIT_CONFIG_NOSYSTEM=1 GIT_CONFIG_GLOBAL=/dev/null
if [[ -n "$screenshot" ]]; then
    TMPDIR="$profile/" "$agent_app/Contents/MacOS/Edit" --agent-check "$screenshot"
else
    TMPDIR="$profile/" "$agent_app/Contents/MacOS/Edit" --agent-check
fi
