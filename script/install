#!/bin/bash
set -euo pipefail
application_directory="${1:-$HOME/Applications}"
mkdir -p "$application_directory"
application_directory="$(cd "$application_directory" && pwd -P)"
cd "$(dirname "$0")/.."
source script/app-bundle.sh

destination="$application_directory/Edit.app"
if [[ -e "$destination" || -L "$destination" ]]; then
    bundle_id="$(/usr/libexec/PlistBuddy -c 'Print :CFBundleIdentifier' \
        "$destination/Contents/Info.plist" 2>/dev/null || true)"
    if [[ -L "$destination" || "$bundle_id" != dev.edit-swift.Edit ]]; then
        printf 'Another application already occupies %s\n' "$destination" >&2
        exit 1
    fi
fi

bin_directory="${EDIT_BIN_DIRECTORY:-/opt/homebrew/bin}"
mkdir -p -- "$bin_directory"
launcher="$bin_directory/edit"
marker='# Installed by Swift Edit.'
if [[ -L "$launcher" ]] ||
   [[ -e "$launcher" && ( ! -f "$launcher" || "$(sed -n '2{p;q;}' "$launcher")" != "$marker" ) ]]; then
    printf '%s already exists\n' "$launcher" >&2
    exit 1
fi

./script/build release
prune_retired_apps "$application_directory"
stage="$(mktemp -d "$application_directory/.edit-install.XXXXXX")"
app="$stage/Edit.app"
trap 'finish_app_stage "$stage" "$app"
if [[ -n ${launcher_stage:-} ]]; then
    rm -f -- "$launcher_stage"
fi' EXIT
cp -cR "${EDIT_BUILD_DIR:-$PWD/.build}/app/release/Edit.app" "$app"
verify_app "$app"
publish_app "$app" "$destination"
printf 'Installed %s\n' "$destination"

launcher_stage="$(mktemp "$bin_directory/.edit-launcher.XXXXXX")"
{
    printf '#!/bin/bash\n%s\nset -- %q "$@"\n' "$marker" "$destination"
    tail -n +2 script/open-app
} > "$launcher_stage"
chmod 755 "$launcher_stage"
mv -fh -- "$launcher_stage" "$launcher"
printf 'Installed %s\n' "$launcher"
